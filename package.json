{
	"name": "@harperdb/http-cache",
	"version": "1.2.1",
	"type": "commonjs",
	"description": "A Harper Component for caching HTTP requests/responses, allowing caching of data from HTTP-level components.",
	"keywords": [
		"harper",
		"caching"
	],
	"homepage": "https://github.com/HarperFast/http-cache",
	"bugs": {
		"url": "https://github.com/HarperFast/http-cache/issues",
		"email": "support@harperdb.io"
	},
	"author": {
		"name": "Harper",
		"email": "support@harperdb.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HarperFast/http-cache.git"
	},
	"license": "Apache-2.0",
	"files": [
		"cacheUtils.js",
		"config.yaml",
		"extension.js",
		"schema.graphql",
		"test/loadTest.js"
	],
	"scripts": {
		"format": "prettier --write .",
		"test:unit": "node --test --experimental-test-coverage --test-coverage-include=extension.js --test-coverage-include=cacheUtils.js test/*.test.js",
		"test:integration": "harper-integration-test-run integrationTests/**/*.test.ts"
	},
	"devDependencies": {
		"@harperdb/code-guidelines": "^0.0.2",
		"@harperfast/integration-testing": "^0.4.0",
		"harper": "^5.2.1",
		"harperdb-4.6": "npm:harperdb@4.6.26",
		"harperdb-4.7": "npm:harperdb@4.7.42",
		"prettier": "^3.3.3",
		"typescript": "^6.0.3"
	},
	"prettier": "@harperdb/code-guidelines/prettier"
}
